{
  "name": "minicpp",
  "displayName": "MiniC++",
  "description": "Language support for MiniC++ (diagnostics, hover, completion, go-to-definition)",
  "version": "0.1.0",
  "publisher": "cvogtlaender",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "minicpp",
        "aliases": ["MiniC++", "minicpp"],
        "extensions": [".mcpp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "minicpp",
        "scopeName": "source.minicpp",
        "path": "./syntaxes/minicpp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MiniC++",
      "properties": {
        "minicpp.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the minicpp-lsp start script. Empty: use lsp/build/install/minicpp-lsp from this repository (run './gradlew :lsp:installDist' first)."
        },
        "minicpp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "typescript": "^5.6.0"
  }
}
